# Supabase Server-Side Credentials (Configure in Netlify Environment Variables for Production)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini AI API Key (server-side only; configure in Netlify Environment Variables for Production)
# Use a real Google AI Studio API key. Do not use Antigravity CLI, OAuth, session, or VITE_ credentials.
# GET /api/health reports geminiConfigured (key present) and geminiAuthenticated
# (a real Gemini API request was accepted by Google).
GEMINI_API_KEY=

# Optional. Overrides the Gemini model used by extraction and the health probe.
# When unset, the first model that passes a live authentication check is used.
GEMINI_MODEL=

# JWT Secret Key
JWT_SECRET=
